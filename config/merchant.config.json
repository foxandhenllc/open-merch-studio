{
  "$schema": "./merchant.schema.json",
  "schemaVersion": 1,
  "brand": {
    "displayName": "Open Merch Studio",
    "shortName": "OMS",
    "shortDescription": "Open-source custom merch workbench",
    "logoPath": "/icon.svg",
    "socialImagePath": "/open-merch-studio-share.png",
    "colors": {
      "background": "#f5f5f2",
      "foreground": "#171814",
      "accent": "#3154d9"
    }
  },
  "web": {
