# Open Merch Studio local environment template
# Copy the backend values to backend/.env and frontend values to frontend/.env.
# Keep real credentials in local env files or deployment-managed values only.

# Backend
NODE_ENV=development
PORT=5001
BACKEND_URL=http://127.0.0.1:5001
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/open_merch_studio

# Optional OpenAI integration. Leave empty to use the local mock design provider.
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
OPENAI_DESIGN_MODEL=gpt-image-2
REMOVE_BG_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-nano

# Optional Printful integration. Leave empty to use fixture-backed catalog data.
PRINTFUL_API_KEY=
PRINTFUL_STORE_ID=
PRINTFUL_SELLING_REGION=north_america
PRINTFUL_CURATED_PRODUCT_IDS=
PRINTFUL_MAX_LAUNCH_PRODUCTS=6
PRINTFUL_MOCKUP_TIMEOUT_MS=180000

# Optional Stripe integration. Leave empty to use fixture checkout; no real charge is created.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Customer communication templates are available, but app-owned delivery stays disabled until a
# branded sender domain and exactly-once delivery record are verified.
TRANSACTIONAL_EMAILS_ENABLED=false
EMAIL_PROVIDER=fixture
EMAIL_FROM=
EMAIL_REPLY_TO=support@openmerchstudio.com
SUPPORT_EMAIL=support@openmerchstudio.com
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Optional admin API guard. Set in deployments before exposing backend admin routes.
ADMIN_ACCESS_CODE=

# Pricing controls
DEFAULT_CURRENCY=USD
TARGET_MARGIN_PERCENT=30
MIN_MARGIN_CENTS=500
AI_DESIGN_FEE_CENTS=300
PAYMENT_FEE_PERCENT=2.9
PAYMENT_FEE_FIXED_CENTS=30
STUDIO_PASS_PRICE_CENTS=500
STUDIO_PASS_ENABLED=false
FREE_DRAFT_LIMIT=3
DAILY_AI_BUDGET_CENTS=2500
PER_SESSION_AI_BUDGET_CENTS=800
REMOVE_BG_ESTIMATED_COST_CENTS=200

# Live provider gates. Keep false until private setup and launch review are complete.
# Server-authoritative checkout access. ENABLE_PUBLIC_CHECKOUT is legacy and ignored.
CHECKOUT_ACCESS_MODE=closed
CHECKOUT_ALLOWED_EMAILS=
ENABLE_LIVE_OPENAI=false
ENABLE_LIVE_STRIPE=false
ENABLE_LIVE_PRINTFUL=false
ALLOW_LIVE_PAYMENTS=false
ALLOW_LIVE_FULFILLMENT=false
PRINTFUL_AUTO_CONFIRM_ORDERS=false
# Local fixture checkout is safe with all live-provider gates above disabled. Production must
# override this to false until an explicitly supervised checkout window.
CHECKOUT_ENABLED=true
FULFILLMENT_ENABLED=false

# Frontend
# Keep API requests same-origin in local Vite; the dev proxy forwards them to the backend.
VITE_API_URL=
VITE_DEV_API_PROXY=http://127.0.0.1:5001
VITE_PUBLIC_APP_MODE=oss
VITE_ENABLE_PUBLIC_CHECKOUT=false
VITE_ENABLE_LOCAL_FALLBACKS=true
VITE_SUPPORT_EMAIL=support@openmerchstudio.com
