{
  "name": "open-merch-studio-frontend",
  "version": "0.1.0",
  "description": "Frontend for Open Merch Studio.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/generate-static-routes.mjs && node scripts/verify-static-routes.mjs",
    "generate:static-routes": "node scripts/generate-static-routes.mjs",
    "generate:brand-assets": "node scripts/generate-brand-assets.mjs",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "verify:static-routes": "node scripts/verify-static-routes.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.30",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "playwright": "^1.57.0",
    "prettier": "^3.1.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^8.0.14"
  }
}
