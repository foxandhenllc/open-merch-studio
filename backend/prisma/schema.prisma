generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CatalogCategory {
  id               String           @id @default(uuid())
  printfulId       Int?             @unique
  parentPrintfulId Int?
  title            String
  slug             String           @unique
  imageUrl         String?
  isLaunchCategory Boolean          @default(false)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  products         CatalogProduct[]

  @@index([isLaunchCategory, isActive])
  @@map("catalog_categories")
}

model CatalogProduct {
  id               String            @id @default(uuid())
  printfulId       Int?              @unique
  title            String
  slug             String            @unique
  type             String?
  brand            String?
  description      String?
  thumbnailUrl     String?
  categoryId       String?
  sellingRegion    String            @default("north_america")
  isSellable       Boolean           @default(false)
  isActive         Boolean           @default(true)
  metadata         Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  category         CatalogCategory?  @relation(fields: [categoryId], references: [id])
  variants         CatalogVariant[]
  placements       PrintPlacement[]
  mockupStyles     MockupStyle[]
  priceSnapshots   PriceSnapshot[]
  quoteItems       QuoteItem[]
  orderItems       OrderItem[]

  @@index([isSellable, isActive])
  @@index([categoryId])
  @@map("catalog_products")
}

model CatalogVariant {
  id                String          @id @default(uuid())
  printfulVariantId Int?            @unique
  productId         String
  name              String
  sku               String?
  size              String?
  color             String?
  colorCode         String?
  imageUrl          String?
  availability      Json?
  isAvailable       Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  product           CatalogProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceSnapshots    PriceSnapshot[]
  quoteItems        QuoteItem[]
  orderItems        OrderItem[]

  @@index([productId, isAvailable])
  @@map("catalog_variants")
}

model PrintPlacement {
  id          String         @id @default(uuid())
  productId   String
  code        String
  displayName String
  technique   String         @default("dtg")
  width       Decimal?       @db.Decimal(10, 2)
  height      Decimal?       @db.Decimal(10, 2)
  orientation String?
  isDefault   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  product     CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, code, technique])
  @@map("print_placements")
}

model MockupStyle {
  id              String         @id @default(uuid())
  productId       String
  printfulStyleId Int?
  styleName       String
  viewName        String
  placement       String?
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  product         CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, isActive])
  @@map("mockup_styles")
}

model PriceSnapshot {
  id         String          @id @default(uuid())
  productId  String
  variantId  String?
  source     String          @default("printful")
  currency   String          @default("USD")
  amount     Decimal         @db.Decimal(10, 2)
  priceType  String          @default("base")
  capturedAt DateTime        @default(now())
  product    CatalogProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    CatalogVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId, variantId, priceType, capturedAt])
  @@map("price_snapshots")
}

model CatalogSyncRun {
  id             String    @id @default(uuid())
  status         String
  source         String    @default("printful")
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  productsSeen   Int       @default(0)
  variantsSeen   Int       @default(0)
  categoriesSeen Int       @default(0)
  errorMessage   String?
  metadata       Json?

  @@index([status, startedAt])
  @@map("catalog_sync_runs")
}

model DesignAsset {
  id              String      @id @default(uuid())
  prompt          String
  provider        String      @default("mock")
  imageUrl        String?
  transparentUrl  String?
  readinessStatus String      @default("pending")
  readinessReport Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  quoteItems      QuoteItem[]
  orderItems      OrderItem[]

  @@map("design_assets")
}

model Quote {
  id                   String      @id @default(uuid())
  currency             String      @default("USD")
  productCostCents     Int
  shippingEstimateCents Int
  taxEstimateCents     Int         @default(0)
  aiDesignFeeCents     Int
  paymentFeeCents      Int
  targetMarginCents    Int
  totalCents           Int
  expiresAt            DateTime
  createdAt            DateTime    @default(now())
  items                QuoteItem[]

  @@index([expiresAt])
  @@map("quotes")
}

model QuoteItem {
  id              String         @id @default(uuid())
  quoteId         String
  productId       String
  variantId       String
  designAssetId   String?
  quantity        Int            @default(1)
  placementCodes  String[]
  unitCostCents   Int
  unitRetailCents Int
  options         Json?
  quote           Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product         CatalogProduct @relation(fields: [productId], references: [id])
  variant         CatalogVariant @relation(fields: [variantId], references: [id])
  designAsset     DesignAsset?   @relation(fields: [designAssetId], references: [id])

  @@index([quoteId])
  @@map("quote_items")
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  quoteId         String?
  email           String?
  status          OrderStatus @default(DRAFT)
  stripeSessionId String?
  printfulOrderId String?
  totalCents      Int
  currency        String      @default("USD")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]

  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id              String          @id @default(uuid())
  orderId         String
  productId       String
  variantId       String
  designAssetId   String?
  quantity        Int             @default(1)
  placementCodes  String[]
  unitRetailCents Int
  printfulPayload Json?
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         CatalogProduct  @relation(fields: [productId], references: [id])
  variant         CatalogVariant  @relation(fields: [variantId], references: [id])
  designAsset     DesignAsset?    @relation(fields: [designAssetId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

enum OrderStatus {
  DRAFT
  QUOTED
  PENDING_PAYMENT
  PAID
  SUBMITTED
  SHIPPED
  CANCELLED
  REFUNDED
}
