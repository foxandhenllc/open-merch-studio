generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CatalogCategory {
  id               String           @id @default(uuid())
  printfulId       Int?             @unique
  parentPrintfulId Int?
  title            String
  slug             String           @unique
  imageUrl         String?
  isLaunchCategory Boolean          @default(false)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  products         CatalogProduct[]

  @@index([isLaunchCategory, isActive])
  @@map("catalog_categories")
}

model CatalogProduct {
  id             String           @id @default(uuid())
  printfulId     Int?             @unique
  title          String
  slug           String           @unique
  type           String?
  brand          String?
  description    String?
  thumbnailUrl   String?
  categoryId     String?
  sellingRegion  String           @default("north_america")
  isSellable     Boolean          @default(false)
  isActive       Boolean          @default(true)
  curationStatus String           @default("unreviewed")
  curatedAt      DateTime?
  curatedBy      String?
  curationNotes  String?
  metadata       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  category       CatalogCategory? @relation(fields: [categoryId], references: [id])
  variants       CatalogVariant[]
  placements     PrintPlacement[]
  mockupStyles   MockupStyle[]
  priceSnapshots PriceSnapshot[]
  quoteItems     QuoteItem[]
  orderItems     OrderItem[]
  savedProducts  SavedProduct[]

  @@index([isSellable, isActive])
  @@index([categoryId])
  @@map("catalog_products")
}

model CatalogVariant {
  id                String          @id @default(uuid())
  printfulVariantId Int?            @unique
  productId         String
  name              String
  sku               String?
  size              String?
  color             String?
  colorCode         String?
  imageUrl          String?
  availability      Json?
  isAvailable       Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  product           CatalogProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceSnapshots    PriceSnapshot[]
  quoteItems        QuoteItem[]
  orderItems        OrderItem[]
  savedProducts     SavedProduct[]

  @@index([productId, isAvailable])
  @@map("catalog_variants")
}

model PrintPlacement {
  id          String         @id @default(uuid())
  productId   String
  code        String
  displayName String
  technique   String         @default("dtg")
  width       Decimal?       @db.Decimal(10, 2)
  height      Decimal?       @db.Decimal(10, 2)
  orientation String?
  isDefault   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  product     CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, code, technique])
  @@map("print_placements")
}

model MockupStyle {
  id              String         @id @default(uuid())
  productId       String
  printfulStyleId Int?
  styleName       String
  viewName        String
  placement       String?
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  product         CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, isActive])
  @@map("mockup_styles")
}

model PriceSnapshot {
  id         String          @id @default(uuid())
  productId  String
  variantId  String?
  source     String          @default("printful")
  currency   String          @default("USD")
  amount     Decimal         @db.Decimal(10, 2)
  priceType  String          @default("base")
  capturedAt DateTime        @default(now())
  product    CatalogProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    CatalogVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId, variantId, priceType, capturedAt])
  @@map("price_snapshots")
}

model CatalogSyncRun {
  id             String    @id @default(uuid())
  status         String
  source         String    @default("printful")
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  productsSeen   Int       @default(0)
  variantsSeen   Int       @default(0)
  categoriesSeen Int       @default(0)
  errorMessage   String?
  metadata       Json?

  @@index([status, startedAt])
  @@map("catalog_sync_runs")
}

model DesignAsset {
  id                  String          @id @default(uuid())
  studioSessionId     String?
  prompt              String
  provider            String          @default("mock")
  sourceType          String          @default("generated")
  purpose             String          @default("print")
  imageUrl            String?
  transparentUrl      String?
  originalStoragePath String?
  previewStoragePath  String?
  printStoragePath    String?
  mimeType            String?
  originalFilename    String?
  byteSize            Int?
  width               Int?
  height              Int?
  hasAlpha            Boolean?
  checksumSha256      String?
  parentAssetIds      Json?
  rightsConfirmedAt   DateTime?
  retentionUntil      DateTime?
  generationStatus    String          @default("complete")
  policyStatus        String          @default("pass")
  policyReport        Json?
  failureReason       String?
  readinessStatus     String          @default("pending")
  readinessReport     Json?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  studioSession       StudioSession?  @relation(fields: [studioSessionId], references: [id], onDelete: SetNull)
  quoteItems          QuoteItem[]
  orderItems          OrderItem[]
  spendEvents         AiSpendEvent[]
  designVersions      DesignVersion[]

  @@index([studioSessionId, createdAt])
  @@index([sourceType, generationStatus, createdAt])
  @@index([retentionUntil])
  @@map("design_assets")
}

model StudioSession {
  id             String         @id @default(uuid())
  status         String         @default("guest")
  freeDraftsUsed Int            @default(0)
  freeDraftLimit Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  passes         StudioPass[]
  spendEvents    AiSpendEvent[]
  designAssets   DesignAsset[]

  @@index([status, createdAt])
  @@map("studio_sessions")
}

model StudioPass {
  id                  String        @id @default(uuid())
  sessionId           String
  status              String        @default("simulated")
  priceCents          Int           @default(500)
  creditCents         Int           @default(500)
  includedRoughDrafts Int           @default(8)
  includedEdits       Int           @default(2)
  includedFinals      Int           @default(1)
  roughDraftsUsed     Int           @default(0)
  editsUsed           Int           @default(0)
  finalsUsed          Int           @default(0)
  appliedOrderId      String?
  createdAt           DateTime      @default(now())
  expiresAt           DateTime?
  session             StudioSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status])
  @@map("studio_passes")
}

model AiSpendEvent {
  id                 String        @id @default(uuid())
  sessionId          String
  designAssetId      String?
  action             String
  provider           String
  estimatedCostCents Int           @default(0)
  createdAt          DateTime      @default(now())
  session            StudioSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  designAsset        DesignAsset?  @relation(fields: [designAssetId], references: [id])

  @@index([sessionId, createdAt])
  @@index([action, provider, createdAt])
  @@map("ai_spend_events")
}

model MockupTask {
  id             String   @id @default(uuid())
  productId      String
  variantId      String
  designAssetId  String?
  provider       String   @default("fixture")
  status         String   @default("queued")
  placementCodes String[]
  imageUrl       String?
  providerTaskId String?
  errorMessage   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, createdAt])
  @@map("mockup_tasks")
}

model AdminSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_settings")
}

model AuditLog {
  id        String   @id @default(uuid())
  actor     String?
  action    String
  target    String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([action, createdAt])
  @@map("audit_logs")
}

model Quote {
  id                         String      @id @default(uuid())
  currency                   String      @default("USD")
  productCostCents           Int
  shippingEstimateCents      Int
  taxEstimateCents           Int         @default(0)
  aiDesignFeeCents           Int
  paymentFeeCents            Int
  targetMarginCents          Int
  studioPassCreditCents      Int         @default(0)
  subtotalBeforeCreditsCents Int         @default(0)
  costLines                  Json?
  estimateFlags              Json?
  totalCents                 Int
  expiresAt                  DateTime
  createdAt                  DateTime    @default(now())
  items                      QuoteItem[]
  orders                     Order[]

  @@index([expiresAt])
  @@map("quotes")
}

model QuoteItem {
  id              String         @id @default(uuid())
  quoteId         String
  productId       String
  variantId       String
  designAssetId   String?
  quantity        Int            @default(1)
  placementCodes  String[]
  unitCostCents   Int
  unitRetailCents Int
  options         Json?
  quote           Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product         CatalogProduct @relation(fields: [productId], references: [id])
  variant         CatalogVariant @relation(fields: [variantId], references: [id])
  designAsset     DesignAsset?   @relation(fields: [designAssetId], references: [id])

  @@index([quoteId])
  @@map("quote_items")
}

model Order {
  id                      String                  @id @default(uuid())
  orderNumber             String                  @unique
  quoteId                 String?
  email                   String?
  status                  OrderStatus             @default(DRAFT)
  stripeSessionId         String?
  stripePaymentIntentId   String?                 @unique
  printfulOrderId         String?
  fulfillmentStatus       String                  @default("not_submitted")
  failureReason           String?
  recipient               Json?
  operatorReviewStatus    String                  @default("unreviewed")
  operatorReviewedAt      DateTime?
  totalCents              Int
  taxCents                Int                     @default(0)
  refundedCents           Int                     @default(0)
  paidAt                  DateTime?
  policyVersion           String?
  policyAcceptedAt        DateTime?
  currency                String                  @default("USD")
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  quote                   Quote?                  @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  items                   OrderItem[]
  transitions             OrderTransition[]
  paymentEvents           PaymentEvent[]
  fulfillmentAttempts     FulfillmentAttempt[]
  shipments               Shipment[]
  customerEmailDeliveries CustomerEmailDelivery[]
  providerWebhookEvents   ProviderWebhookEvent[]
  customerAccessGrants    OrderAccessGrant[]

  @@index([status, createdAt])
  @@index([stripeSessionId])
  @@index([operatorReviewStatus, createdAt])
  @@map("orders")
}

model OrderAccessGrant {
  id         String    @id @default(uuid())
  orderId    String
  tokenHash  String    @unique
  purpose    String    @default("browser")
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, purpose, revokedAt])
  @@map("order_access_grants")
}

model OrderTransition {
  id        String   @id @default(uuid())
  orderId   String
  status    String
  note      String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_transitions")
}

model PaymentEvent {
  id              String   @id @default(uuid())
  orderId         String
  provider        String   @default("stripe")
  providerEventId String?
  eventType       String
  status          String
  payload         Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([provider, providerEventId])
  @@index([orderId, createdAt])
  @@map("payment_events")
}

model FulfillmentAttempt {
  id              String   @id @default(uuid())
  orderId         String
  provider        String   @default("printful")
  providerOrderId String?
  status          String
  payload         Json?
  errorMessage    String?
  createdAt       DateTime @default(now())
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("fulfillment_attempts")
}

model Shipment {
  id                 String    @id @default(uuid())
  orderId            String
  provider           String    @default("printful")
  providerShipmentId String
  status             String
  carrier            String?
  service            String?
  trackingNumber     String?
  trackingUrl        String?
  items              Json?
  reshipment         Boolean   @default(false)
  shippedAt          DateTime?
  deliveredAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([provider, providerShipmentId])
  @@index([orderId, shippedAt])
  @@map("shipments")
}

model CustomerEmailDelivery {
  id                String    @id @default(uuid())
  orderId           String
  eventKey          String    @unique
  kind              String
  recipientEmail    String
  provider          String    @default("resend")
  providerMessageId String?
  status            String    @default("pending")
  attempts          Int       @default(0)
  lastError         String?
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([status, updatedAt])
  @@map("customer_email_deliveries")
}

model ProviderWebhookEvent {
  id                   String    @id @default(uuid())
  orderId              String?
  provider             String
  eventHash            String
  eventType            String
  publicKeyFingerprint String?
  storeId              String?
  status               String    @default("processing")
  attempts             Int       @default(1)
  lastError            String?
  processedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  order                Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([provider, eventHash])
  @@index([orderId, createdAt])
  @@index([provider, status, updatedAt])
  @@map("provider_webhook_events")
}

model OrderItem {
  id              String         @id @default(uuid())
  orderId         String
  productId       String
  variantId       String
  designAssetId   String?
  quantity        Int            @default(1)
  placementCodes  String[]
  unitRetailCents Int
  printfulPayload Json?
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         CatalogProduct @relation(fields: [productId], references: [id])
  variant         CatalogVariant @relation(fields: [variantId], references: [id])
  designAsset     DesignAsset?   @relation(fields: [designAssetId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Organization {
  id               String               @id @default(uuid())
  name             String
  slug             String               @unique
  status           String               @default("active")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  members          OrganizationMember[]
  ownerMemberships OwnerMembership[]
  brandProfile     BrandProfile?
  savedDesigns     SavedDesign[]
  savedProducts    SavedProduct[]
  collections      MerchCollection[]
  storefronts      Storefront[]

  @@unique([id, slug])
  @@index([status, createdAt])
  @@map("organizations")
}

// Legacy OrganizationMember rows are never promoted into authenticated owner grants.
model OwnerIdentity {
  id          String            @id @default(uuid())
  issuer      String
  subject     String
  status      String            @default("disabled")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  memberships OwnerMembership[]

  @@unique([issuer, subject])
  @@map("owner_identities")
}

model OwnerMembership {
  id               String        @id @default(uuid())
  identityId       String
  organizationId   String
  // Composite FK lets RLS scope by the route slug without recursive organization policies.
  organizationSlug String
  role             String        @default("viewer")
  status           String        @default("inactive")
  revokedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  identity         OwnerIdentity @relation(fields: [identityId], references: [id], onDelete: Restrict)
  organization     Organization  @relation(fields: [organizationId, organizationSlug], references: [id, slug], onDelete: Cascade)

  @@unique([organizationId, identityId])
  @@index([identityId, organizationSlug])
  @@map("owner_memberships")
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  subject        String
  role           String       @default("editor")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, subject])
  @@index([subject])
  @@map("organization_members")
}

model BrandProfile {
  id               String       @id @default(uuid())
  organizationId   String       @unique
  displayName      String
  shortDescription String?
  logoUrl          String?
  primaryColor     String       @default("#111111")
  accentColor      String       @default("#d76732")
  supportEmail     String?
  websiteUrl       String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("brand_profiles")
}

model SavedProduct {
  id              String              @id @default(uuid())
  organizationId  String
  productId       String
  variantId       String
  designVersionId String
  title           String
  slug            String
  status          String              @default("draft")
  defaultQuantity Int                 @default(1)
  placementCodes  String[]
  configuration   Json
  mockupUrl       String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product         CatalogProduct      @relation(fields: [productId], references: [id])
  variant         CatalogVariant      @relation(fields: [variantId], references: [id])
  designVersion   DesignVersion       @relation(fields: [designVersionId], references: [id], onDelete: Restrict)
  collections     CollectionProduct[]

  @@unique([organizationId, slug])
  @@index([organizationId, status, createdAt])
  @@map("saved_products")
}

model SavedDesign {
  id             String          @id @default(uuid())
  organizationId String
  title          String
  slug           String
  status         String          @default("active")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions       DesignVersion[]

  @@unique([organizationId, slug])
  @@index([organizationId, status, createdAt])
  @@map("saved_designs")
}

model DesignVersion {
  id                String         @id @default(uuid())
  savedDesignId     String
  designAssetId     String
  versionNumber     Int
  provenance        Json
  rightsConfirmedAt DateTime?
  createdAt         DateTime       @default(now())
  savedDesign       SavedDesign    @relation(fields: [savedDesignId], references: [id], onDelete: Cascade)
  designAsset       DesignAsset    @relation(fields: [designAssetId], references: [id], onDelete: Restrict)
  savedProducts     SavedProduct[]

  @@unique([savedDesignId, versionNumber])
  @@index([designAssetId])
  @@map("design_versions")
}

model MerchCollection {
  id             String              @id @default(uuid())
  organizationId String
  title          String
  slug           String
  description    String?
  heroImageUrl   String?
  status         String              @default("draft")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products       CollectionProduct[]
  storefronts    Storefront[]

  @@unique([organizationId, slug])
  @@index([organizationId, status, createdAt])
  @@map("merch_collections")
}

model CollectionProduct {
  id             String          @id @default(uuid())
  collectionId   String
  savedProductId String
  position       Int             @default(0)
  createdAt      DateTime        @default(now())
  collection     MerchCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  savedProduct   SavedProduct    @relation(fields: [savedProductId], references: [id], onDelete: Cascade)

  @@unique([collectionId, savedProductId])
  @@unique([collectionId, position])
  @@index([savedProductId])
  @@map("collection_products")
}

model Storefront {
  id             String          @id @default(uuid())
  organizationId String
  collectionId   String
  title          String
  slug           String
  status         String          @default("draft")
  publishedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  collection     MerchCollection @relation(fields: [collectionId], references: [id], onDelete: Restrict)

  @@unique([organizationId, slug])
  @@index([status, publishedAt])
  @@map("storefronts")
}

enum OrderStatus {
  DRAFT
  QUOTED
  PENDING_PAYMENT
  PAID
  FULFILLMENT_VALIDATING
  NEEDS_REVIEW
  FAILED
  SUBMITTED
  IN_PRODUCTION
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}
